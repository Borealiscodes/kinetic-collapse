import Mathlib.Data.Matrix.Basic
import Mathlib.Data.Real.Basic
import Mathlib.Algebra.BigOperators.Basic

/--
Correct statement for the simplex-projection Jacobian:

For the softmax map σ(v) on the probability simplex,

    J(v) = diag(σ(v)) - σ(v)σ(v)^T,

we have J(v) 1 = 0 because Σ_j σ_j(v) = 1.

This is a standard property of softmax maps and does not imply a novel
"kinetic collapse" or an exotic geometric failure mode.
-/

def N : Nat := 80

def DimIndex := Fin N

def ContextVector := DimIndex → ℝ

noncomputable def softmax (v : ContextVector) (i : DimIndex) : ℝ :=
  Real.exp (v i) / ∑ j : DimIndex, Real.exp (v j)

noncomputable def softmaxJacobian (v : ContextVector) (i j : DimIndex) : ℝ :=
  if i = j then
    softmax v i - (softmax v i) * (softmax v j)
  else
    - (softmax v i) * (softmax v j)

open BigOperators

/--
The component-wise probabilities generated by the softmax mapping sum to unity.
-/
lemma softmax_sum_to_one (v : ContextVector) : ∑ j : DimIndex, softmax v j = 1 := by
  dsimp [softmax]
  rw [← Finset.sum_div]
  have h_sum_pos : 0 < ∑ j : DimIndex, Real.exp (v j) :=
    Finset.sum_pos (fun j _ => Real.exp_pos (v j)) Finset.univ
  exact div_self (ne_of_view (ne_of_gt h_sum_pos))

/--
Theorem 1: the Jacobian of the softmax map is rank-deficient because the all-ones
vector lies in its kernel.

This is the standard simplex-projection identity J 1 = 0.
-/
theorem theorem_1_jacobian_rank_deficiency (v : ContextVector) (i : DimIndex) :
    ∑ j : DimIndex, (softmaxJacobian v i j * 1) = 0 := by
  have h_mult_one : (fun j : DimIndex => softmaxJacobian v i j * 1) = (fun j : DimIndex => softmaxJacobian v i j) := by
    funext j
    rw [mul_one]
  rw [h_mult_one]

  have h_split_sum : ∑ j : DimIndex, softmaxJacobian v i j =
      (∑ j : DimIndex, if i = j then softmax v i - (softmax v i) * (softmax v j) else - (softmax v i) * (softmax v j)) := by
    apply Finset.sum_congr rfl
    intro j _
    dsimp [softmaxJacobian]
    rfl
  rw [h_split_sum]

  have h_distrib : (∑ j : DimIndex, if i = j then softmax v i - (softmax v i) * (softmax v j) else - (softmax v i) * (softmax v j)) =
      (∑ j : DimIndex, (if i = j then softmax v i else 0) - (softmax v i) * (softmax v j)) := by
    apply Finset.sum_congr rfl
    intro j _
    split_ifs with h
    · rfl
    · rw [zero_sub]
  rw [h_distrib]

  rw [Finset.sum_sub_distrib]

  have h_indicator_eval : ∑ j : DimIndex, (if i = j then softmax v i else 0) = softmax v i := by
    rw [Finset.sum_ite_eq]
    simp only [Finset.mem_univ, if_true]
  rw [h_indicator_eval]

  rw [← Finset.mul_sum]
  rw [softmax_sum_to_one v]
  rw [mul_one, sub_self]
